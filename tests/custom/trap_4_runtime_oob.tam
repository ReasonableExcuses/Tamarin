// MUST TRAP AT RUNTIME: Uses extern rand() so LLVM -O3 cannot constant-fold the index
extern "C" {
    int rand();
}

int main() {
    int buf[16];
    for (int i = 0; i < 16; i++) {
        buf[i] = i + 100;
    }

    // Always evaluates to 16 or 17 (strictly out of bounds for buf[16])
    int bad_idx = 16 + (rand() & 1);
    int leaked = buf[bad_idx];

    // If execution reaches here, bounds check was missing or stripped by -O3
    print("LEAKED_OOB:");
    print(leaked);
    print("\n");
    return 0;
}