@c_layout
public struct Camera2D {
    Vector2 offset;
    Vector2 target;
    float rotation;
    float zoom;
};

@c_layout
public struct Mesh {
    int vertexCount;
    int triangleCount;
    *float vertices;
    *float texcoords;
    *float texcoords2;
    *float normals;
    *float tangents;
    *u8 colors;
    *u16 indices;
    *float animVertices;
    *float animNormals;
    *u8 boneIds;
    *float boneWeights;
    *Matrix boneMatrices;
    int boneCount;
    u32 vaoId;
    *u32 vboId;
};

@c_layout
public struct Shader {
    u32 id;
    *int locs;
};

@c_layout
public struct MaterialMap {
    Texture texture;
    Color color;
    float value;
};

@c_layout
public struct Material {
    Shader shader;
    *MaterialMap maps;
    float[4] params;
};

@c_layout
public struct Transform {
    Vector3 translation;
    Vector4 rotation;
    Vector3 scale;
};

@c_layout
public struct BoneInfo {
    i8[32] name;
    int parent;
};

@c_layout
public struct Model {
    Matrix transform;
    int meshCount;
    int materialCount;
    *Mesh meshes;
    *Material materials;
    *int meshMaterial;
    int boneCount;
    *BoneInfo bones;
    *Transform bindPose;
};

@c_layout
public struct ModelAnimation {
    int boneCount;
    int frameCount;
    *BoneInfo bones;
    **Transform framePoses;
    i8[32] name;
};

@c_layout
public struct Ray {
    Vector3 position;
    Vector3 direction;
};

@c_layout
public struct RayCollision {
    bool hit;
    float distance;
    Vector3 point;
    Vector3 normal;
};

@c_layout
public struct BoundingBox {
    Vector3 min_;
    Vector3 max_;
};

@c_layout
public struct Wave {
    u32 frameCount;
    u32 sampleRate;
    u32 sampleSize;
    u32 channels;
    *void data;
};

@c_layout
public struct AudioStream {
    *rAudioBuffer buffer;
    *rAudioProcessor processor;
    u32 sampleRate;
    u32 sampleSize;
    u32 channels;
};

@c_layout
public struct Sound {
    AudioStream stream;
    u32 frameCount;
};

@c_layout
public struct Music {
    AudioStream stream;
    u32 frameCount;
    bool looping;
    int ctxType;
    *void ctxData;
};

@c_layout
public struct VrDeviceInfo {
    int hResolution;
    int vResolution;
    float hScreenSize;
    float vScreenSize;
    float eyeToScreenDistance;
    float lensSeparationDistance;
    float interpupillaryDistance;
    float[4] lensDistortionValues;
    float[4] chromaAbCorrection;
};

@c_layout
public struct VrStereoConfig {
    Matrix[2] projection;
    Matrix[2] viewOffset;
    float[2] leftLensCenter;
    float[2] rightLensCenter;
    float[2] leftScreenCenter;
    float[2] rightScreenCenter;
    float[2] scale;
    float[2] scaleIn;
};

@c_layout
public struct FilePathList {
    u32 capacity;
    u32 count;
    **u8 paths;
};

@c_layout
public struct AutomationEvent {
    u32 frame;
    u32 type_;
    int[4] params;
};

@c_layout
public struct AutomationEventList {
    u32 capacity;
    u32 count;
    *AutomationEvent events;
};

@c_layout
public struct rAudioBuffer {
    u8[1] _opaque;
};

@c_layout
public struct rAudioProcessor {
    u8[1] _opaque;
};

