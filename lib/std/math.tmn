// ============================================================================
// std.math - Common Mathematical Functions for TAMARIN
// ============================================================================

public int abs(int x) {
    if (x == -2147483647 - 1) {
        return 2147483647;
    }
    if (x < 0) {
        return -x;
    }
    return x;
}

public float fabs(float x) {
    if (x < 0.0f || (x == 0.0f && (1.0f / x) < 0.0f)) {
        return -x;
    }
    return x;
}

public int min(int a, int b) {
    if (a < b) {
        return a;
    }
    return b;
}

public int max(int a, int b) {
    if (a > b) {
        return a;
    }
    return b;
}

public float fmin(float a, float b) {
    if (a != a) {
        return b;
    }
    if (b != b) {
        return a;
    }
    if (a < b) {
        return a;
    }
    return b;
}

public float fmax(float a, float b) {
    if (a != a) {
        return b;
    }
    if (b != b) {
        return a;
    }
    if (a > b) {
        return a;
    }
    return b;
}

public int clamp(int val, int low, int high) {
    if (low > high) {
        int tmp = low;
        low = high;
        high = tmp;
    }
    if (val < low) {
        return low;
    }
    if (val > high) {
        return high;
    }
    return val;
}

public float fclamp(float val, float low, float high) {
    if (low > high) {
        float tmp = low;
        low = high;
        high = tmp;
    }
    if (val < low) {
        return low;
    }
    if (val > high) {
        return high;
    }
    return val;
}

public int ipow(int base, int exp) {
    if (exp < 0) {
        if (base == 1) {
            return 1;
        }
        if (base == -1) {
            if ((exp & 1) != 0) {
                return -1;
            }
            return 1;
        }
        return 0;
    }
    if (exp == 0) {
        return 1;
    }
    int res = 1;
    while (exp > 0) {
        if ((exp & 1) != 0) {
            res *= base;
        }
        base *= base;
        exp = exp >> 1;
    }
    return res;
}

public float sqrtf(float x) {
    return __builtin_sqrtf(x);
}

public double sqrt(double x) {
    return __builtin_sqrt(x);
}

