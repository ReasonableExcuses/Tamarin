// ============================================================================
// std.bits - Hardware Bit-Twiddling Intrinsics and Bitwise Algorithms
// ============================================================================

public int popcnt(int x) {
    return __builtin_popcnt(x);
}

public int popcount(int x) {
    return __builtin_popcount(x);
}

public int clz(int x) {
    return __builtin_clz(x);
}

public int ctz(int x) {
    return __builtin_ctz(x);
}

public int bitrev(int x) {
    return __builtin_bitrev(x);
}

public int bitreverse(int x) {
    return __builtin_bitreverse(x);
}

public int bswap(int x) {
    return __builtin_bswap(x);
}

public bool is_power_of_two(int x) {
    return x > 0 && (x & (x - 1)) == 0;
}

public int next_power_of_two(int x) {
    if (x <= 1) { return 1; }
    return 1 << (32 - __builtin_clz(x - 1));
}

public int rotl(int x, int r) {
    int shift = r & 31;
    if (shift == 0) { return x; }
    return (x << shift) | ((x >> (32 - shift)) & ((1 << shift) - 1));
}

public int rotr(int x, int r) {
    int shift = r & 31;
    if (shift == 0) { return x; }
    return ((x >> shift) & ((1 << (32 - shift)) - 1)) | (x << (32 - shift));
}

public int hash_code(int x) {
    return __builtin_hash(x);
}
