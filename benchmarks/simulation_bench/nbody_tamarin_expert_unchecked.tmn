// 13_nbody_simulation - Tamarin Expert Unchecked (Flat SoA)
// 4,096 bodies, 20 time steps = 335,544,320 pairwise interactions

import std.mem as mem;

void print_f64_4(double val) {
    if (val < 0.0) {
        print("-");
        val = 0.0 - val;
    }
    long int_part = (long)val;
    double frac = val - (double)int_part;
    long frac_int = (long)(frac * 10000.0 + 0.5);
    if (frac_int >= 10000) {
        int_part = int_part + 1;
        frac_int = frac_int - 10000;
    }
    print(int_part);
    print(".");
    if (frac_int < 10) {
        print("000");
    } else if (frac_int < 100) {
        print("00");
    } else if (frac_int < 1000) {
        print("0");
    }
    print(frac_int);
}

int main() {
    float pos_x[4096];
    float pos_y[4096];
    float pos_z[4096];
    float vel_x[4096];
    float vel_y[4096];
    float vel_z[4096];
    float mass[4096];

    long seed = 123456789;

    // Deterministic LCG initialization outside timed kernel
    for (int i = 0; i < 4096; i++) {
        seed = (seed * 1664525 + 1013904223) & 2147483647;
        pos_x[i] = ((float)(seed & 65535) / 65535.0f) * 20.0f - 10.0f;

        seed = (seed * 1664525 + 1013904223) & 2147483647;
        pos_y[i] = ((float)(seed & 65535) / 65535.0f) * 20.0f - 10.0f;

        seed = (seed * 1664525 + 1013904223) & 2147483647;
        pos_z[i] = ((float)(seed & 65535) / 65535.0f) * 20.0f - 10.0f;

        seed = (seed * 1664525 + 1013904223) & 2147483647;
        vel_x[i] = ((float)(seed & 65535) / 65535.0f) * 2.0f - 1.0f;

        seed = (seed * 1664525 + 1013904223) & 2147483647;
        vel_y[i] = ((float)(seed & 65535) / 65535.0f) * 2.0f - 1.0f;

        seed = (seed * 1664525 + 1013904223) & 2147483647;
        vel_z[i] = ((float)(seed & 65535) / 65535.0f) * 2.0f - 1.0f;

        seed = (seed * 1664525 + 1013904223) & 2147483647;
        mass[i] = ((float)(seed & 65535) / 65535.0f) * 9.9f + 0.1f;
    }

    float dt = 0.01f;
    float softening = 0.01f;

    __benchmark_start();

    // 20 simulation time steps with unchecked contiguous array indexing
    for (int step = 0; step < 20; step++) {
        for (int i = 0; i < 4096; i++) {
            float px = pos_x[i];
            float py = pos_y[i];
            float pz = pos_z[i];
            float ax = 0.0f;
            float ay = 0.0f;
            float az = 0.0f;

            for (int j = 0; j < 4096; j++) {
                float dx = mem::get_unchecked<float>(pos_x, j) - px;
                float dy = mem::get_unchecked<float>(pos_y, j) - py;
                float dz = mem::get_unchecked<float>(pos_z, j) - pz;
                float distSqr = dx * dx + dy * dy + dz * dz + softening;
                float invDist = 1.0f / sqrtf(distSqr);
                float invDist3 = invDist * invDist * invDist;
                float s = mem::get_unchecked<float>(mass, j) * invDist3;
                ax = ax + dx * s;
                ay = ay + dy * s;
                az = az + dz * s;
            }

            vel_x[i] = vel_x[i] + ax * dt;
            vel_y[i] = vel_y[i] + ay * dt;
            vel_z[i] = vel_z[i] + az * dt;

            pos_x[i] = px + vel_x[i] * dt;
            pos_y[i] = py + vel_y[i] * dt;
            pos_z[i] = pz + vel_z[i] * dt;
        }
    }

    double elapsed_ms = __benchmark_elapsed_ms();

    float total_x = 0.0f;
    float total_y = 0.0f;
    float total_z = 0.0f;
    float total_v = 0.0f;
    float total_ek = 0.0f;

    for (int i = 0; i < 4096; i++) {
        total_x = total_x + pos_x[i];
        total_y = total_y + pos_y[i];
        total_z = total_z + pos_z[i];
        total_v = total_v + vel_x[i] + vel_y[i] + vel_z[i];
        float vsq = vel_x[i] * vel_x[i] + vel_y[i] * vel_y[i] + vel_z[i] * vel_z[i];
        total_ek = total_ek + 0.5f * mass[i] * vsq;
    }

    long checksum = (long)total_x + (long)total_y + (long)total_z + (long)total_v + (long)total_ek;

    print("TIME_MS:");
    print_f64_4(elapsed_ms);
    print(";TOTAL_X:");
    print((long)total_x);
    print(";TOTAL_Y:");
    print((long)total_y);
    print(";TOTAL_Z:");
    print((long)total_z);
    print(";TOTAL_V:");
    print((long)total_v);
    print(";TOTAL_EK:");
    print((long)total_ek);
    print(";CHECKSUM:");
    print(checksum);
    print("\n");

    return 0;
}
