// 13_nbody_simulation - Tamarin Normal (AoS)
// 4,096 bodies, 20 time steps = 335,544,320 pairwise interactions

struct Particle {
    float x;
    float y;
    float z;
    float vx;
    float vy;
    float vz;
    float mass;
};

void print_f64_4(double val) {
    if (val < 0.0) {
        print("-");
        val = 0.0 - val;
    }
    long int_part = (long)val;
    double frac = val - (double)int_part;
    long frac_int = (long)(frac * 10000.0 + 0.5);
    if (frac_int >= 10000) {
        int_part = int_part + 1;
        frac_int = frac_int - 10000;
    }
    print(int_part);
    print(".");
    if (frac_int < 10) {
        print("000");
    } else if (frac_int < 100) {
        print("00");
    } else if (frac_int < 1000) {
        print("0");
    }
    print(frac_int);
}

int main() {
    Particle p[4096];
    long seed = 123456789;

    // Deterministic LCG initialization outside timed kernel
    for (int i = 0; i < 4096; i++) {
        seed = (seed * 1664525 + 1013904223) & 2147483647;
        p[i].x = ((float)(seed & 65535) / 65535.0f) * 20.0f - 10.0f;

        seed = (seed * 1664525 + 1013904223) & 2147483647;
        p[i].y = ((float)(seed & 65535) / 65535.0f) * 20.0f - 10.0f;

        seed = (seed * 1664525 + 1013904223) & 2147483647;
        p[i].z = ((float)(seed & 65535) / 65535.0f) * 20.0f - 10.0f;

        seed = (seed * 1664525 + 1013904223) & 2147483647;
        p[i].vx = ((float)(seed & 65535) / 65535.0f) * 2.0f - 1.0f;

        seed = (seed * 1664525 + 1013904223) & 2147483647;
        p[i].vy = ((float)(seed & 65535) / 65535.0f) * 2.0f - 1.0f;

        seed = (seed * 1664525 + 1013904223) & 2147483647;
        p[i].vz = ((float)(seed & 65535) / 65535.0f) * 2.0f - 1.0f;

        seed = (seed * 1664525 + 1013904223) & 2147483647;
        p[i].mass = ((float)(seed & 65535) / 65535.0f) * 9.9f + 0.1f;
    }

    float dt = 0.01f;
    float softening = 0.01f;

    __benchmark_start();

    // 20 simulation time steps
    for (int step = 0; step < 20; step++) {
        for (int i = 0; i < 4096; i++) {
            float px = p[i].x;
            float py = p[i].y;
            float pz = p[i].z;
            float ax = 0.0f;
            float ay = 0.0f;
            float az = 0.0f;

            for (int j = 0; j < 4096; j++) {
                float dx = p[j].x - px;
                float dy = p[j].y - py;
                float dz = p[j].z - pz;
                float distSqr = dx * dx + dy * dy + dz * dz + softening;
                float invDist = 1.0f / sqrtf(distSqr);
                float invDist3 = invDist * invDist * invDist;
                float s = p[j].mass * invDist3;
                ax = ax + dx * s;
                ay = ay + dy * s;
                az = az + dz * s;
            }

            p[i].vx = p[i].vx + ax * dt;
            p[i].vy = p[i].vy + ay * dt;
            p[i].vz = p[i].vz + az * dt;

            p[i].x = px + p[i].vx * dt;
            p[i].y = py + p[i].vy * dt;
            p[i].z = pz + p[i].vz * dt;
        }
    }

    double elapsed_ms = __benchmark_elapsed_ms();

    float total_x = 0.0f;
    float total_y = 0.0f;
    float total_z = 0.0f;
    float total_v = 0.0f;
    float total_ek = 0.0f;

    for (int i = 0; i < 4096; i++) {
        total_x = total_x + p[i].x;
        total_y = total_y + p[i].y;
        total_z = total_z + p[i].z;
        total_v = total_v + p[i].vx + p[i].vy + p[i].vz;
        float vsq = p[i].vx * p[i].vx + p[i].vy * p[i].vy + p[i].vz * p[i].vz;
        total_ek = total_ek + 0.5f * p[i].mass * vsq;
    }

    long checksum = (long)total_x + (long)total_y + (long)total_z + (long)total_v + (long)total_ek;

    print("TIME_MS:");
    print_f64_4(elapsed_ms);
    print(";TOTAL_X:");
    print((long)total_x);
    print(";TOTAL_Y:");
    print((long)total_y);
    print(";TOTAL_Z:");
    print((long)total_z);
    print(";TOTAL_V:");
    print((long)total_v);
    print(";TOTAL_EK:");
    print((long)total_ek);
    print(";CHECKSUM:");
    print(checksum);
    print("\n");

    return 0;
}
