// 08_memory_ops.tmn - Memory and String Operations Benchmark
// Tests byte buffer operations, character transformations, and pattern matching

void print_f64_4(double val) {
    if (val < 0.0) {
        print("-");
        val = 0.0 - val;
    }
    long int_part = (long)val;
    double frac = val - (double)int_part;
    long frac_int = (long)(frac * 10000.0 + 0.5);
    if (frac_int >= 10000) {
        int_part = int_part + 1;
        frac_int = frac_int - 10000;
    }
    print(int_part);
    print(".");
    if (frac_int < 10) {
        print("000");
    } else if (frac_int < 100) {
        print("00");
    } else if (frac_int < 1000) {
        print("0");
    }
    print(frac_int);
}

int main() {
    char buf[16384];

    // Initialize buffer outside timed section
    for (int i = 0; i < 16384; i++) {
        int rem = i % 26;
        if ((i & 1) == 0) {
            buf[i] = (char)(65 + rem); // 'A' .. 'Z'
        } else {
            buf[i] = (char)(97 + rem); // 'a' .. 'z'
        }
    }

    __benchmark_start();

    // 1. In-place case inversion (200 passes)
    long transform_count = 0;
    for (int pass = 0; pass < 200; pass++) {
        for (int i = 0; i < 16384; i++) {
            char c = buf[i];
            if (c >= (char)65 && c <= (char)90) {
                buf[i] = (char)((int)c + 32);
                transform_count++;
            } else if (c >= (char)97 && c <= (char)122) {
                buf[i] = (char)((int)c - 32);
                transform_count++;
            }
        }
    }

    // 2. Linear scan pattern search (100 passes)
    long matches = 0;
    for (int pass = 0; pass < 100; pass++) {
        for (int i = 0; i < 16380; i++) {
            if (buf[i] == (char)65 && buf[i + 1] == (char)98 && buf[i + 2] == (char)67) {
                matches++;
            }
        }
    }

    long byte_sum = 0;
    for (int i = 0; i < 16384; i++) {
        byte_sum += (long)((int)buf[i]);
    }

    double elapsed_ms = __benchmark_elapsed_ms();

    long checksum = transform_count + matches + byte_sum;
    print("TIME_MS:");
    print_f64_4(elapsed_ms);
    print(";TRANSFORMS:");
    print(transform_count);
    print(";MATCHES:");
    print(matches);
    print(";BYTE_SUM:");
    print(byte_sum);
    print(";CHECKSUM:");
    print(checksum);
    print("\n");
    return 0;
}
