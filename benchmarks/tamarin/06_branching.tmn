// 06_branching.tmn - Control Flow and Branching Benchmark
// Tests predictable vs unpredictable branch prediction performance

void print_f64_4(double val) {
    if (val < 0.0) {
        print("-");
        val = 0.0 - val;
    }
    long int_part = (long)val;
    double frac = val - (double)int_part;
    long frac_int = (long)(frac * 10000.0 + 0.5);
    if (frac_int >= 10000) {
        int_part = int_part + 1;
        frac_int = frac_int - 10000;
    }
    print(int_part);
    print(".");
    if (frac_int < 10) {
        print("000");
    } else if (frac_int < 100) {
        print("00");
    } else if (frac_int < 1000) {
        print("0");
    }
    print(frac_int);
}

int main() {
    __benchmark_start();

    // 1. Predictable branching pattern (5,000,000 iterations)
    long pred_sum = 0;
    for (int i = 0; i < 5000000; i++) {
        int rem = i % 4;
        if (rem == 0) {
            pred_sum += (long)(i * 3);
        } else if (rem == 1) {
            pred_sum += (long)(i * 5);
        } else if (rem == 2) {
            pred_sum -= (long)(i * 2);
        } else {
            pred_sum += (long)i;
        }
    }

    // 2. Unpredictable branching pattern (5,000,000 iterations via LCG)
    long unpred_sum = 0;
    long lcg = 2147483647;
    for (int i = 0; i < 5000000; i++) {
        lcg = (lcg * 1664525 + 1013904223) & 2147483647;
        if ((lcg & 1) == 0) {
            unpred_sum += (lcg >> 16);
        } else {
            unpred_sum -= (lcg >> 16);
        }
    }

    double elapsed_ms = __benchmark_elapsed_ms();

    long checksum = pred_sum + unpred_sum;
    print("TIME_MS:");
    print_f64_4(elapsed_ms);
    print(";PRED:");
    print(pred_sum);
    print(";UNPRED:");
    print(unpred_sum);
    print(";CHECKSUM:");
    print(checksum);
    print("\n");
    return 0;
}
