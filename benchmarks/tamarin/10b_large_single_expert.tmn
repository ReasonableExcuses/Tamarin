// 10b_large_single_expert.tmn - Expert Pattern B: Large single region (10,000 allocations)
// Optimized with geometric commit scaling and unrolled inner loop

void print_f64_4(double val) {
    if (val < 0.0) {
        print("-");
        val = 0.0 - val;
    }
    long int_part = (long)val;
    double frac = val - (double)int_part;
    long frac_int = (long)(frac * 10000.0 + 0.5);
    if (frac_int >= 10000) {
        int_part = int_part + 1;
        frac_int = frac_int - 10000;
    }
    print(int_part);
    print(".");
    if (frac_int < 10) {
        print("000");
    } else if (frac_int < 100) {
        print("00");
    } else if (frac_int < 1000) {
        print("0");
    }
    print(frac_int);
}

int main() {
    __benchmark_start();

    long sum = 0;
    region r(1048576) {
        for (int alloc = 0; alloc < 10000; alloc++) {
            long buf[8];
            long base = (long)(alloc * 8);
            @unroll(4)
            for (int j = 0; j < 8; j += 4) {
                buf[j] = base + (long)j;
                buf[j + 1] = base + (long)(j + 1);
                buf[j + 2] = base + (long)(j + 2);
                buf[j + 3] = base + (long)(j + 3);
                sum += buf[j] + buf[j + 1] + buf[j + 2] + buf[j + 3];
            }
        }
    }

    double elapsed_ms = __benchmark_elapsed_ms();

    print("TIME_MS:");
    print_f64_4(elapsed_ms);
    print(";SUM:");
    print(sum);
    print(";CHECKSUM:");
    print(sum);
    print("\n");
    return 0;
}

