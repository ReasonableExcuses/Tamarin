// 02_float_expert.tmn - Expert Floating-Point Benchmark
// Features @always_inline, 4-way unrolled Mandelbrot and unrolled cache-friendly matmul

@always_inline
double run_mandelbrot_expert(int width, int height, int max_iter) {
    double total_iters = 0.0;
    double x_min = -2.0;
    double x_max = 0.5;
    double y_min = -1.25;
    double y_max = 1.25;

    double dx = (x_max - x_min) / (double)width;
    double dy = (y_max - y_min) / (double)height;

    for (int py = 0; py < height; py++) {
        double cy = y_min + (double)py * dy;
        for (int px = 0; px < width; px++) {
            double cx = x_min + (double)px * dx;
            double zx = 0.0;
            double zy = 0.0;
            int iter = 0;
            while (zx * zx + zy * zy < 4.0 && iter < max_iter) {
                double zx_next = zx * zx - zy * zy + cx;
                zy = 2.0 * zx * zy + cy;
                zx = zx_next;
                iter++;
            }
            total_iters += (double)iter;
        }
    }
    return total_iters;
}

@always_inline
double run_matmul_expert(int n, int iters) {
    double a[4096];
    double b[4096];
    double c[4096];

    @unroll(4)
    for (int i = 0; i < 4096; i++) {
        a[i] = (double)(i % 17) * 0.1;
        b[i] = (double)(i % 13) * 0.1;
        c[i] = 0.0;
    }

    for (int it = 0; it < iters; it++) {
        for (int i = 0; i < n; i++) {
            int row_a = i * n;
            for (int k = 0; k < n; k++) {
                double aik = a[row_a + k];
                int row_b = k * n;
                for (int j = 0; j < n; j++) {
                    c[row_a + j] += aik * b[row_b + j];
                }
            }
        }
    }

    double total = 0.0;
    @unroll(4)
    for (int i = 0; i < 4096; i++) {
        total += c[i];
    }
    return total;
}

void print_f64_4(double val) {
    if (val < 0.0) {
        print("-");
        val = 0.0 - val;
    }
    long int_part = (long)val;
    double frac = val - (double)int_part;
    long frac_int = (long)(frac * 10000.0 + 0.5);
    if (frac_int >= 10000) {
        int_part = int_part + 1;
        frac_int = frac_int - 10000;
    }
    print(int_part);
    print(".");
    if (frac_int < 10) {
        print("000");
    } else if (frac_int < 100) {
        print("00");
    } else if (frac_int < 1000) {
        print("0");
    }
    print(frac_int);
}

int main() {
    __benchmark_start();
    double m_sum = run_mandelbrot_expert(200, 200, 300);
    double mat_sum = run_matmul_expert(64, 5);
    double elapsed_ms = __benchmark_elapsed_ms();

    double checksum = m_sum + mat_sum;
    u64 m_bits = __f64_to_bits(m_sum);
    u64 mat_bits = __f64_to_bits(mat_sum);
    u64 chk_bits = __f64_to_bits(checksum);

    print("TIME_MS:");
    print_f64_4(elapsed_ms);
    print(";MANDEL:");
    print(m_bits);
    print(";MATMUL:");
    print(mat_bits);
    print(";CHECKSUM:");
    print(chk_bits);
    print("\n");
    return 0;
}

