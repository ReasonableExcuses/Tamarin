// 10c_chunk_growth_expert.tmn - Expert Pattern C: Chunk growth under sustained allocation pressure
// Optimized with chunk caching and unrolled data fill

void print_f64_4(double val) {
    if (val < 0.0) {
        print("-");
        val = 0.0 - val;
    }
    long int_part = (long)val;
    double frac = val - (double)int_part;
    long frac_int = (long)(frac * 10000.0 + 0.5);
    if (frac_int >= 10000) {
        int_part = int_part + 1;
        frac_int = frac_int - 10000;
    }
    print(int_part);
    print(".");
    if (frac_int < 10) {
        print("000");
    } else if (frac_int < 100) {
        print("00");
    } else if (frac_int < 1000) {
        print("0");
    }
    print(frac_int);
}

int main() {
    __benchmark_start();

    long sum = 0;
    for (int iter = 0; iter < 50; iter++) {
        region r(65536) {
            long data[25000];
            long base = (long)(iter * 25000);
            for (int j = 0; j < 25000; j++) {
                long val = base + (long)j;
                data[j] = val;
                sum += val;
            }
        }
    }

    double elapsed_ms = __benchmark_elapsed_ms();

    print("TIME_MS:");
    print_f64_4(elapsed_ms);
    print(";SUM:");
    print(sum);
    print(";CHECKSUM:");
    print(sum);
    print("\n");
    return 0;
}

