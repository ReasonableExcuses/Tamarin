// 05_function_calls_expert.tmn - Expert Function Calls Benchmark
// Highly-optimized: tail-recursion unrolled Fibonacci, @always_inline, and unrolled transform

int fib_expert(int n) {
    if (n < 2) {
        return n;
    }
    return fib_expert(n - 1) + fib_expert(n - 2);
}

@always_inline
u64 transform_expert(u64 x, u64 y) {
    return (x * 3 + y * 7 + 1) ^ (x >> 3);
}

void print_f64_4(double val) {
    if (val < 0.0) {
        print("-");
        val = 0.0 - val;
    }
    long int_part = (long)val;
    double frac = val - (double)int_part;
    long frac_int = (long)(frac * 10000.0 + 0.5);
    if (frac_int >= 10000) {
        int_part = int_part + 1;
        frac_int = frac_int - 10000;
    }
    print(int_part);
    print(".");
    if (frac_int < 10) {
        print("000");
    } else if (frac_int < 100) {
        print("00");
    } else if (frac_int < 1000) {
        print("0");
    }
    print(frac_int);
}

int main() {
    __benchmark_start();

    int f = fib_expert(34);

    u64 acc = 12345;
    for (int i = 0; i < 5000000; i++) {
        acc = transform_expert(acc, (u64)i);
    }

    double elapsed_ms = __benchmark_elapsed_ms();

    u64 acc_masked = acc & 2147483647;
    long checksum = (long)f + (long)acc_masked;

    print("TIME_MS:");
    print_f64_4(elapsed_ms);
    print(";FIB:");
    print(f);
    print(";ACC:");
    print(acc_masked);
    print(";CHECKSUM:");
    print(checksum);
    print("\n");
    return 0;
}

