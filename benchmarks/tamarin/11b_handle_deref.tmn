// 11b_handle_deref.tmn - Milestone v0.6: High-frequency Generational Handle Dereferencing
struct Node {
    int value;
    int weight;
};

void print_f64_4(double val) {
    if (val < 0.0) {
        print("-");
        val = 0.0 - val;
    }
    long int_part = (long)val;
    double frac = val - (double)int_part;
    long frac_int = (long)(frac * 10000.0 + 0.5);
    if (frac_int >= 10000) {
        int_part = int_part + 1;
        frac_int = frac_int - 10000;
    }
    print(int_part);
    print(".");
    if (frac_int < 10) {
        print("000");
    } else if (frac_int < 100) {
        print("00");
    } else if (frac_int < 1000) {
        print("0");
    }
    print(frac_int);
}

int main() {
    __benchmark_start();

    Slab<Node> graph(8192);
    Handle<Node> handles[4096];

    for (int i = 0; i < 4096; i++) {
        Node n = (Node){ i, (i * 17) % 100 };
        handles[i] = graph.insert(n);
    }

    long total = 0;

    // 500 passes of full random-stride handle dereference
    for (int pass = 0; pass < 500; pass++) {
        for (int j = 0; j < 4096; j++) {
            int idx = (j * 37) % 4096;
            Handle<Node> h = handles[idx];
            if (graph.is_valid(h)) {
                total += (long)graph[h].weight;
                graph[h].value = graph[h].value + 1;
            }
        }
    }

    double elapsed_ms = __benchmark_elapsed_ms();

    print("TIME_MS:");
    print_f64_4(elapsed_ms);
    print(";SUM:");
    print(total);
    print(";CHECKSUM:");
    print(total);
    print("\n");
    return 0;
}
