    int atoi(*const u8 str);
    float sqrtf(float x);
    float sinf(float x);
    float cosf(float x);
    float tanf(float x);
    *void memcpy(*void dst, *void src, u64 len);
    *void fopen(*const u8 filename, *const u8 mode);
    u64 fwrite(*void ptr, u64 size, u64 count, *void stream);
    int fclose(*void stream);

    // SDL3 C FFI
    bool SDL_Init(u32 flags);
    void SDL_Quit();
    *const u8 SDL_GetError();
    bool SDL_CreateWindowAndRenderer(*const u8 title, int width, int height, u64 window_flags, *void window, *void renderer);
    void SDL_DestroyWindow(*void window);
