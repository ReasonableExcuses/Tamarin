int sum_array(int values[]) {
    int total = 0;
    for (int i = 0; i < len(values); i++) {
        total += values[i];
    }
    return total;
}

int main() {
    int numbers[5] = {1, 2, 3, 4, 5};
    int acc = 0;
    for (int iter = 0; iter < 1000000; iter++) {
        acc += sum_array(numbers);
    }
    return acc % 256;
}

