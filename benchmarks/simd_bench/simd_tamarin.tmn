int main() {
    __benchmark_start();
    float8 sum_vec = float8(0.0f);
    float8 step = float8(1.0f, 2.0f, 3.0f, 4.0f, 5.0f, 6.0f, 7.0f, 8.0f);
    float total_dot = 0.0f;
    float4 p1 = float4(1.0f, 2.0f, 3.0f, 4.0f);
    float4 p2 = float4(0.5f, 0.5f, 0.5f, 0.5f);

    for (int i = 0; i < 100000000; i++) {
        sum_vec = sum_vec + step;
        total_dot += dot_product(p1, p2);
    }
    float final_sum = reduce_add(sum_vec);
    double elapsed = __benchmark_elapsed_ms();
    print("TIME_MS="); print((int)elapsed); print(";");
    print("SUM="); print((int)final_sum); print(";");
    print("DOT="); print((int)total_dot); print(";");
    return 0;
}
