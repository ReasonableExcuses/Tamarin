int max(int a, int b) {
    if (a > b) {
        return a;
    } else {
        return b;
    }
}

int clamp(int value, int lo, int hi) {
    if (value < lo) {
        return lo;
    }
    if (value > hi) {
        return hi;
    }
    return value;
}

int main() {
    int val = 42;
    int bounded = clamp(val, 0, 100);
    return bounded;
}

