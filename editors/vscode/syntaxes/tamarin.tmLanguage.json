{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Tamarin",
  "scopeName": "source.tamarin",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#attributes" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.tamarin",
          "match": "//.*$"
        },
        {
          "name": "comment.block.tamarin",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.tamarin",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.tamarin",
              "match": "\\\\([0btnvfr\"'\\\\]|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4})"
            }
          ]
        },
        {
          "name": "string.quoted.single.tamarin",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.tamarin",
              "match": "\\\\([0btnvfr\"'\\\\]|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4})"
            }
          ]
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "entity.other.attribute-name.tamarin",
          "match": "@(c_layout|layout|cfg|export|no_escape|pure|inline|must_use|nodiscard)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.tamarin",
          "match": "\\b(if|else|while|for|do|switch|case|default|return|break|continue|parallel|reduce|spawn|sync|match|select|async|await|defer|task_scope)\\b"
        },
        {
          "name": "keyword.declaration.tamarin",
          "match": "\\b(struct|class|enum|trait|impl|import|interface|typedef|fn|operator)\\b"
        },
        {
          "name": "storage.modifier.tamarin",
          "match": "\\b(const|public|private|protected|virtual|override|static|extern|auto|pub|tag|atomic|unsafe|where|cold)\\b"
        },
        {
          "name": "keyword.operator.tamarin",
          "match": "\\b(sizeof|alignof|as|this|min|max|reduction)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.primitive.tamarin",
          "match": "\\b(i8|i16|i32|i64|i128|isize|u8|u16|u32|u64|u128|usize|f32|f64|int|int8|int16|int32|int64|uint|uint8|uint16|uint32|uint64|byte|short|long|unsigned|float|double|bool|char|string|void|size_t|ptrdiff_t|float4|float8|int4|span|chan|Task|Handle|Slab)\\b"
        },
        {
          "name": "entity.name.type.tamarin",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.tamarin",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.tamarin",
          "match": "\\b0[xX][0-9a-fA-F_]+(\\.[0-9a-fA-F_]+)?([pP][+-]?[0-9_]+)?(u8|u16|u32|u64|i8|i16|i32|i64|u|i|l|ll|ul|ull)?\\b"
        },
        {
          "name": "constant.numeric.binary.tamarin",
          "match": "\\b0[bB][01_]+(u8|u16|u32|u64|i8|i16|i32|i64|u|i)?\\b"
        },
        {
          "name": "constant.numeric.float.tamarin",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9_]+)?(f32|f64|f)?\\b"
        },
        {
          "name": "constant.numeric.integer.tamarin",
          "match": "\\b[0-9][0-9_]*(u8|u16|u32|u64|u128|i8|i16|i32|i64|i128|u|i|l|ll|ul|ull)?\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.tamarin",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.tamarin",
          "match": "(\\+|-|\\*|/|%|==|!=|<=|>=|<|>|&&|\\|\\||!|&|\\||\\^|~|<<|>>|=)"
        }
      ]
    }
  }
}
